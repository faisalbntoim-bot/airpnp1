# -------- Runtime --------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TZ=Asia/Riyadh
DEFAULT_CURRENCY=SAR

# -------- Database --------
# Dev: SQLite (file). Prod: Postgres.
DATABASE_URL="file:./dev.db"
# For production, use e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/sakanhub?schema=public"

# -------- Payment provider --------
# Values: sandbox | moyasar | tap
PAYMENT_PROVIDER=sandbox

# Secrets: SERVER-SIDE ONLY. Never expose to mobile/web.
# Leave empty in dev; providers are stubbed unless real keys are set.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
TAP_BASE_URL=https://api.tap.company

# -------- Auth --------
JWT_SECRET=change-me-in-production
JWT_ISSUER=sakanhub-backend
JWT_EXPIRES_IN=7d

# -------- Financial defaults (used only when no DB rule matches) --------
# Every number here is OVERRIDABLE by an admin via /admin/rules.
DEFAULT_PLATFORM_FEE_PERCENT=5
DEFAULT_TAX_RATE_PERCENT=15

# -------- Rounding --------
# banker | half-up | half-down
MONEY_ROUNDING=banker
